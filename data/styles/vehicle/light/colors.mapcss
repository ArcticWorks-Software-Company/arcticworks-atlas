/* BASE
 * ArcticWorks Design palette (light, derived per @arcticworks/design methodology).
 * See docs/ARCTICWORKS_THEME.md.
 */

@background: #F2F2F4;

/* BOUNDARIES */
@border_country: #8B8B93;
/* @border_country_light: #A8A8B0; */
@border_region: #A8A8B0;


/* ROADS */

@trunk0: #4E4E56;
