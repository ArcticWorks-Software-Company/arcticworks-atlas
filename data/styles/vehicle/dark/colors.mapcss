/* ~~~~ CONTENT OF COLORS-DARK ~~~~~

ArcticWorks Design palette (dark, official @arcticworks/design tokens).
See docs/ARCTICWORKS_THEME.md.

1.BASEMAP
2.BOUNDARY
3.NATURAL
	3.1 Main natural
	3.2 Vegetation
4.LANDUSE
	4.1 Main landuse
	4.2 Aerodrome
  4.3 Barriers
  4.4 Buildings
5.ROADS
  5.1 All roads
	5.2 Bridges
  5.3 Tunnels
  5.4 Piste
  5.5 Transport
 6.LABELS COLORS
  6.1 Main labels
  6.2 Natural labels
  6.3 Place labels
  6.4 Road labels
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

/* 1.BASEMAP */

@background: #0B0B0D;

/* 2.BOUNDARY */

@border_country: #4E4E56;
@border_region: #3A3A42;

/* 3.NATURAL */
/* 3.1 Main natural */

@glacier: #1D1D22;
@water: #245BC2;
@water_bad: #2A55A8;
@river: #2B6FD9;
@wetland: #20313F;
@beach: #26241E;
@barerock: #232328;
@desert: #26241F;

/*3.2 Vegetation*/

@forest: #101413;
@green0: #101413;
@green1: #101413;
@green2: #101413;
@green3: #101413;
@green4: #101413;
@green5: #101413;
@green6: #243A24;

/* 4.LANDUSE */
/*4.1 Main landuse*/

/*
@university: #1B1B22;
@hospital: #231818;
*/
@general_area: #111114;
@industrial: #131316;
@construction_area: #131316;
@sport: #101413;
@military: #4A2222;
@prison: #3A3A42;
@parking: #17171B;
@parking_l: #1B1B20;
@farmland: #1F1E15;
@farmyard: #211F17;

/*4.2 Aerodrome*/

@aerodrome0: #1F2832;
@aerodrome1: #1F2832;
@aerodrome2: #1F2832;
@aerodrome3: #1F2832;
@aerodrome4: #1F2832;
@aerodrome5: #1F2832;

/* 4.3 Barriers */
@fence: #4E4E56;
@hedge: #18251A;
@cliff: #3A3A42;

/* 4.4 Buildings */

@building0: #2C2C33;
@building1: #27272E;
@building_border0: #1D1D22;

/* 5.ROADS */
/* 5.1 All roads */

@trunk0: #6F6F78;
@trunk1: #6F6F78;
@primary0: #5A5A62;
@primary1: #5A5A62;
@primary2: #5A5A62;
@secondary0: #3A3A42;
@residential: #242427;
@unclassified: #222226;
@pedestrian: #242427;
@footway: #1D1D22;
@cycleway: #3D82F6;
@construction: #2A2A30;
@track: #3A3A42;
@path: #2C2C33;
@bridleway: #2C2C33;

/* 5.2 Bridges */

@bridge_background: #17171B;
@bridge_casing: #111114;
@casing_road: #0B0B0D;

/* 5.3 Tunnels */

@trunk_tunnel: #3A3A42;
@trunk_tunnel_casing: #17171B;
@primary_tunnel: #2C2C33;
@primary_tunnel_casing: #17171B;
@secondary_tunnel: #242427;
@secondary_tunnel_casing: #17171B;
@tertiary_tunnel: #1D1D22;
@tertiary_tunnel_casing: #17171B;
@unclassified_tunnel: #1D1D22;
@unclassified_tunnel_casing: #17171B;

/* 5.5 Transport */

@railway_light: #3A3A42;
@railway: #2C2C33;
@railway_tourism: #34383F;
@railway_tunnel: #242427;
@railway_dash: #0B0B0D;
/* @aerialway: #5A5A62; */
