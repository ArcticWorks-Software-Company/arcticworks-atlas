@construction: #A8A8B0;

@railway: #9898A1;
@railway_dark: #8B8B93;
@railway_dash: #F2F2F4;

@motorway1_border: #2C2C33;
@trunk1_border: #3A3A42;
@primary1_border: #4E4E56;
@primary2_border: #4E4E56;
@secondary0_border: #5A5A62;
